# =============================================================================
# KORNA MALL — environment template (no real secrets)
# Plain Postgres (VPS): set DATABASE_URL + point supabase-js client at this app.
# =============================================================================

# --- App ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-korna-domain.example.com
PORT=3000

# --- Plain Postgres ---
DATABASE_URL=postgresql://app_user:CHANGE_ME@127.0.0.1:5432/store_korna
# POSTGRES_URL=  # optional alias
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=30000
PGSSL=          # set to "require" if TLS is needed
# PGSSL_REJECT_UNAUTHORIZED=true  # set when using a publicly trusted cert

# Dual-mode flags
NEXT_PUBLIC_USE_PLAIN_PG=true

# Browser supabase-js must target THIS app origin in plain-PG mode
# (hits /auth/v1, /rest/v1, /storage/v1 shims — not a Supabase cloud project)
NEXT_PUBLIC_SUPABASE_URL=https://your-korna-domain.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-or-any-nonempty-string
# Optional: used by REST ACL for service-role bypass on server jobs
SUPABASE_SERVICE_ROLE_KEY=service-role-or-strong-random-string

# Auth JWT (required in production)
AUTH_JWT_SECRET=generate-a-long-random-secret
# JWT_SECRET=
# SUPABASE_JWT_SECRET=

# --- Local disk storage (replaces cloud object storage) ---
STORAGE_ROOT=/data/korna/storage
STORAGE_PUBLIC_URL=https://your-korna-domain.example.com
STORAGE_SIGNING_SECRET=generate-a-long-random-secret

# --- Moolre payments ---
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=admin@example.com
MOOLRE_CALLBACK_SECRET=   # REQUIRED in production

# --- Moolre SMS ---
MOOLRE_SMS_API_KEY=
# MOOLRE_API_KEY=           # fallback for SMS only
MOOLRE_SMS_SENDER_ID=KORNA

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=KORNA MALL <noreply@example.com>
ADMIN_EMAIL=admin@example.com

# --- Cron ---
CRON_SECRET=generate-a-long-random-secret

# --- reCAPTCHA ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Storefront ---
NEXT_PUBLIC_WHATSAPP_NUMBER=233543832358
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Hubtel / Paystack: NOT implemented in this codebase.
